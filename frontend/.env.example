# ---------------------------------------------------------------------------
# IPAM Frontend — environment template
# Copy to .env.local and fill in real values. Never commit a real .env to git.
# ---------------------------------------------------------------------------

# Public API base path. The BFF proxy routes /api/* to the backend.
NEXT_PUBLIC_API_URL="/api"

# Backend URL the BFF server-side proxy connects to (no trailing /api).
API_PROXY_TARGET="http://127.0.0.1:3001"

# Comma-separated exact public origins accepted for browser mutations.
# Used by the BFF for Origin/Referer CSRF validation.
# Must match the URL users type in the browser address bar.
APP_ORIGIN="http://localhost:3003"

# ---------------------------------------------------------------------------
# HeroUI Pro private package
# ---------------------------------------------------------------------------
# DO NOT put HEROUI_AUTH_TOKEN in this file or any .env file.
# It must be passed as an ephemeral shell/CI variable only:
#   HEROUI_AUTH_TOKEN="..." npm ci
# In CI, use a protected GitHub Actions Environment secret fed to BuildKit.
# Never persist this token in platform env vars, image ARG/ENV, or .npmrc.
