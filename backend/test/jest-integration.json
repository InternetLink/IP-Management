{
  "rootDir": "..",
  "testEnvironment": "node",
  "testMatch": [
    "<rootDir>/test/integration/**/*.integration-spec.ts"
  ],
  "maxWorkers": 1,
  "transform": {
    "^.+\\.tsx?$": [
      "ts-jest",
      {
        "tsconfig": "<rootDir>/tsconfig.json"
      }
    ]
  },
  "setupFiles": [
    "<rootDir>/test/integration/load-database-env.cjs"
  ],
  "globalSetup": "<rootDir>/test/integration/global-setup.cjs",
  "globalTeardown": "<rootDir>/test/integration/global-teardown.cjs"
}
