# ---------------------------------------------------------------------------
# IPAM Backend — environment template
# Copy to .env and fill in real values. Never commit a real .env to git.
# ---------------------------------------------------------------------------

# MySQL connection string used by Prisma.
DATABASE_URL="mysql://USER:PASSWORD@HOST:PORT/DATABASE"

# HTTP port the NestJS server listens on.
PORT=3001

# Comma-separated exact origins used by CORS and protected-request Origin checks.
# Use the public frontend URL in production. Backend rejects present-but-unlisted
# Origin headers on protected requests; absent Origin (CLI/curl) is allowed.
CORS_ORIGINS="http://localhost:3003"

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------

# HMAC secret used to sign API auth tokens.
# REQUIRED. Must be at least 32 characters; generate with:
#   openssl rand -base64 48
# The backend refuses to start if this is missing or too short.
AUTH_SECRET="change-me-to-at-least-32-random-characters-aaaaaaaa"

# Token lifetime in days (default 30). This is the PRIMARY TTL variable.
AUTH_TOKEN_TTL_DAYS=30

# Backward-compatible fallback: if AUTH_TOKEN_TTL_DAYS is unset or invalid,
# the backend reads AUTH_TOKEN_TTL_HOURS (default 720 = 30 days).
# Prefer AUTH_TOKEN_TTL_DAYS for new deployments.
# AUTH_TOKEN_TTL_HOURS=720

# ---------------------------------------------------------------------------
# Bootstrap (first-admin creation via operator CLI)
# ---------------------------------------------------------------------------

# One-time token required by the bootstrap flow (npm run auth:bootstrap).
# REQUIRED on first deploy. Must be at least 16 characters; generate with:
#   openssl rand -base64 32
# After the first admin account is created, set BOOTSTRAP_DISABLED=true
# (or remove this value) so the endpoint can never be used again.
BOOTSTRAP_TOKEN="change-me-to-at-least-16-random-characters"

# Operator CLI input. Supply the password only in the deployment/CI environment;
# do not commit a populated value.
BOOTSTRAP_ADMIN_USERNAME="admin"
BOOTSTRAP_ADMIN_PASSWORD=""
# Optional; omit to create the account without an email address.
BOOTSTRAP_ADMIN_EMAIL=""

# Set to "true" to permanently disable the bootstrap flow.
# Recommended after the first admin account exists.
BOOTSTRAP_DISABLED=false

# ---------------------------------------------------------------------------
# Advanced / operational (rarely needed in local dev)
# ---------------------------------------------------------------------------

# Capacity read mode for staged migration transitions.
# Values: "legacy" | "exact-first" | "exact-only"
# Only relevant during the expand/dual-write/contract migration stages.
# CAPACITY_READ_MODE=legacy
